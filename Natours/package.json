{
  "name": "natours",
  "version": "1.0.0",
  "description": "landing page for Natours Project",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "watch:sass": "sass starter/sass/main.scss starter/css/style.css -w",
    "dev-server": "live-server starter",
    "start": "npm-run-all --parallel dev-server watch:sass",
    
    "compile:sass": "sass starter/sass/main.scss starter/css/style.comp.css",
    "concat:css": "concat -o starter/css/style.concat.css starter/css/icon-font.css starter/css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' starter/css/style.concat.css -o starter/css/style.prefix.css",
    "compress:css": "sass starter/css/style.prefix.css:starter/css/style.css --style compressed",
    "build:css": "npm-run-all compile:sass concat:css prefix:css compress:css"
  },
  "author": "Julius",
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "concat": "^1.0.3",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^12.0.0",
    "sass": "^1.104.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
